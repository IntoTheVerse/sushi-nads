# Nginx reverse proxy for Sushi Bonks backend
# Copy to /etc/nginx/conf.d/sushi-bonks.conf (or sites-enabled) and customize
#
# 1. Replace your_domain.com with your actual domain or server IP
# 2. Update proxy_pass port if your app runs on a different port (default: 3000)
# 3. For HTTPS: use certbot or your SSL provider
#    sudo certbot --nginx -d your_domain.com

server {
    listen 80;
    server_name your_domain.com;  # Replace with your domain or IP

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 90s;
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
    }
}
